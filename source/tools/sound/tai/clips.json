{"batches": [{"id": "b53", "title": "第五十批 · 战局开场音乐：汉不吵、楚不急", "date": "10 月 10 日", "note": "照你的备注改：汉“可以不要这么吵”——鼓从三下减到一下或不要，锣压得很轻，以编钟、古筝、古琴为主，整体比上一批轻了 5～6 分贝；楚“太急了，急死了”——鼓只留一两下、隔一秒多，编钟慢慢往下走。时长都还是 3 秒多一点。", "groups": [{"id": "b53_r", "who": "汉", "title": "汉 · 开场（安静）", "hint": "最后一条是上一批你给“还行”的汉甲，对照。", "clips": [{"id": "b53_r_open_0", "label": "丙 · 甲的安静版：一下轻鼓，古筝慢拨，编钟三声，轻锣（推荐）", "text": "汉 · 丙", "src": "audio/b53/r_open_0.mp3"}, {"id": "b53_r_open_1", "label": "丁 · 不要鼓：古琴一声，编钟和古筝对答一句，很轻的锣", "text": "汉 · 丁", "src": "audio/b53/r_open_1.mp3"}, {"id": "b53_r_ref", "label": "对照：上一批的汉甲（还行）", "text": "汉 · 甲", "src": "audio/b53/r_open_2.mp3"}]}, {"id": "b53_b", "who": "楚", "title": "楚 · 开场（慢）", "hint": "", "clips": [{"id": "b53_b_open_0", "label": "丙 · 两下沉鼓隔得很开，古琴低音，编钟慢慢往下，低锣（推荐）", "text": "楚 · 丙", "src": "audio/b53/b_open_0.mp3"}, {"id": "b53_b_open_1", "label": "丁 · 更静：古琴两声，编钟三声，最后一下沉鼓和低锣", "text": "楚 · 丁", "src": "audio/b53/b_open_1.mp3"}]}]}, {"id": "b52", "title": "第四十九批 · 战局开场音乐（楚、汉各一）", "date": "10 月 10 日", "note": "按你说的“战局开场音乐可以做两版，注意时长，和现在的差不多即可。楚汉分别做一版”：现在开局（出「楚汉相争」题字时）是一声锣 + 三下鼓，约 3 秒。新做楚、汉两版，每版多备一种让你挑，都控制在 3～3.5 秒，响度和现在一样。乐器只用真大鼓（决战鼓那套录音）、真锣、编钟、古筝、古琴，没有合成号角、唢呐。汉用宫调（明亮），楚用羽调（沉）。打算：你执汉开局放汉的，执楚放楚的；本地双人放先手汉的。", "groups": [{"id": "b52_r", "who": "汉", "title": "汉 · 开场", "hint": "选一个「就它」，两个都要就随机放。最后一条是现在的开场，对照。", "clips": [{"id": "b52_r_open_0", "label": "甲 · 两下鼓，古筝往上扬，编钟“当—当当—当”，一声锣（推荐）", "text": "汉 · 甲", "src": "audio/b52/r_open_0.mp3"}, {"id": "b52_r_open_1", "label": "乙 · 鼓由轻到重滚上来，三下齐鼓，编钟明亮和弦，锣", "text": "汉 · 乙", "src": "audio/b52/r_open_1.mp3"}, {"id": "b52_ref", "label": "对照：现在的开场（一声锣 + 三下鼓）", "text": "现在的", "src": "audio/b52/r_open_2.mp3"}]}, {"id": "b52_b", "who": "楚", "title": "楚 · 开场", "hint": "选一个「就它」，两个都要就随机放。", "clips": [{"id": "b52_b_open_0", "label": "甲 · 三下沉重的大鼓，古琴低音，编钟羽调往下走，一声低锣（推荐）", "text": "楚 · 甲", "src": "audio/b52/b_open_0.mp3"}, {"id": "b52_b_open_1", "label": "乙 · 鼓点越打越急，古筝急拨，三下重鼓，将士一声齐吼，低锣", "text": "楚 · 乙", "src": "audio/b52/b_open_1.mp3"}]}]}, {"id": "b51", "title": "第四十八批 · 四级兵行军：换鼓、放稀", "date": "10 月 10 日", "note": "照你的“换个鼓，鼓太密集了”：换成原声筒鼓（CC0 合集里真人打的筒鼓滚奏，切出单击、压低成大鼓），鼓点放稀到四步一下（约两秒一下）。另外两种我先试过 0 A.D. 的警报声，量出来不衰减、像号角不像鼓，没拿来。没鼓的重甲大队你上一批也选了，四级先用它，这两种选中的和它一起随机放。", "groups": [{"id": "b51_war", "who": "四级兵", "title": "重甲大队 + 稀的大鼓", "hint": "每种前面一条是单独一下鼓声，后面是配在行军里。", "clips": [{"id": "b51_hit_tomA", "label": "甲 · 单独一下鼓", "text": "甲 · 鼓", "src": "audio/b51/hit_tomA.mp3"}, {"id": "b51_march_tomA", "label": "甲 · 配在重甲大队里，四步一下", "text": "甲 · 行军", "src": "audio/b51/march_heavy_tomA.mp3"}, {"id": "b51_hit_tomC", "label": "乙 · 单独一下鼓（更沉，叠了一层重踏）", "text": "乙 · 鼓", "src": "audio/b51/hit_tomC.mp3"}, {"id": "b51_march_tomC", "label": "乙 · 配在重甲大队里，四步一下", "text": "乙 · 行军", "src": "audio/b51/march_heavy_tomC.mp3"}]}]}, {"id": "b50", "title": "第四十七批 · 四级兵行军加真实战鼓", "date": "10 月 10 日", "note": "上一批六条你都选了，按等级用：初级兵 = 现在的行军声 / 三个人（随机），二级 = 整齐行军，三级 = 行军 + 鼓，四级 = 重甲大队，残血的非初级兵 = 散着走。四级你说“也加个鼓，真实战鼓”：用的是游戏决战鼓那套真实大鼓录音（你以前点过头的），调子压低更沉，配了两种鼓点。选一种，或都要随机。", "groups": [{"id": "b50_war", "who": "四级兵", "title": "重甲大队 + 真实战鼓", "hint": "最后一条是上一批没加鼓的重甲大队，对照。", "clips": [{"id": "b50_war1", "label": "甲 · 每一步一下重鼓，四步一重拍，中间小鼓点", "text": "甲 · 步步鼓", "src": "audio/b50/march_heavy_war1.mp3"}, {"id": "b50_war2", "label": "乙 · “咚——咚咚”，两步一组，更像战场擂鼓", "text": "乙 · 咚咚咚", "src": "audio/b50/march_heavy_war2.mp3"}, {"id": "b50_ref", "label": "对照：上一批的重甲大队（没鼓）", "text": "对照 · 没鼓", "src": "audio/b50/ref_heavy.mp3"}]}]}, {"id": "b49", "title": "第四十六批 · 真实的步兵行军", "date": "10 月 10 日", "note": "按你说的“做一些真实的步兵行军声音”：现在游戏里的行军是 0 A.D. 一段现成的脚步原声，只有脚步。这批用 0 A.D. 一步一条的真实脚步录音（碎石地、沙土地），按人数一步一步叠出来：每个人远近不同（远的轻、闷），每一步随机带甲片、锁链轻响，偶尔盾牌、兵器碰一下，再加一点空间感。拒马的声音已经交给 TD（S3）。", "groups": [{"id": "b49_march", "who": "步兵", "title": "行军 · 选几种「就它」", "hint": "兵种在棋盘上走的时候放。可以多选，选中的按人数、场合用。最后一条是游戏里现在的行军声，对照。", "clips": [{"id": "b49_march_step", "label": "整齐行军：十二个人步调一致，一步 0.55 秒，碎石地（推荐）", "text": "整齐行军", "src": "audio/b49/march_step.mp3"}, {"id": "b49_march_drum", "label": "整齐行军 + 领队鼓点（两步一鼓）", "text": "行军 + 鼓", "src": "audio/b49/march_drum.mp3"}, {"id": "b49_march_heavy", "label": "重甲大队：二十个人，沙土地，甲片响得多", "text": "重甲大队", "src": "audio/b49/march_heavy.mp3"}, {"id": "b49_march_loose", "label": "散着走：十二个人各走各的", "text": "散着走", "src": "audio/b49/march_loose.mp3"}, {"id": "b49_march_three", "label": "三个人（低级兵、人少时）", "text": "三个人", "src": "audio/b49/march_three.mp3"}, {"id": "b49_march_ref", "label": "对照：游戏里现在的行军声", "text": "现在的", "src": "audio/b49/ref_troop.mp3"}]}]}, {"id": "b48", "title": "第四十五批 · 拒马：碎裂往上叠", "date": "10 月 10 日", "note": "照你说的“在这个基础上，再多叠一些木头碎屑，石块，木头断裂，碎块的音效，往上叠”：就在上一批你选的相击杀、象打死上面加——相击杀加了 24 层（木头断裂、碎裂、木头落地、石块碎、石块落地，前 7 层一起炸开，后面一路往下掉一秒）+ 一段爆炸碎块；象打死加了 34 层 + 爆炸碎块 + 一段倒塌。素材：CC0 碎裂落地合集 + 0 A.D. 爆炸碎块、建筑倒塌（都已署名）。第一次叠完我量了，新加的被原来更响的声音盖住了，所以这批把新加的整体提了 6～8 分贝：碎裂段里碎屑声的比例，相击杀从 8% 到 31%，象打死从 14% 到 37%。箭声照你说三种随机轮着用，已记下。", "groups": [{"id": "b48_kill", "who": "拒马", "title": "相击杀、象打死 · 叠厚版", "hint": "每个后面跟着上一批你选的版本，对比。", "clips": [{"id": "b48_xiang_kill", "label": "相击杀 · 碎裂往上叠", "text": "相 · 击杀 · 叠厚", "src": "audio/b48/juma_xiang_kill.mp3"}, {"id": "b48_xiang_kill_ref", "label": "对照：上一批的相击杀", "text": "相 · 击杀 · 上一批", "src": "audio/b48/ref_xiang_kill.mp3"}, {"id": "b48_ele_kill", "label": "象打死 · 碎裂往上叠", "text": "象 · 打死 · 叠厚", "src": "audio/b48/juma_ele_kill.mp3"}, {"id": "b48_ele_kill_ref", "label": "对照：上一批的象打死（十六层）", "text": "象 · 打死 · 上一批", "src": "audio/b48/ref_ele_kill.mp3"}]}]}, {"id": "b47", "title": "第四十四批 · 拒马：去掉“回旋镖”、木头再多", "date": "10 月 10 日", "note": "你问“为什么老找这种像回旋镖的音效”。我查了一遍，上一条回复里说的原因不对：放箭录音本身 0.06 秒后就弱了，真正像回旋镖的，是我给“弩手一阵烟现身 / 化烟退下”配的那条旋转呼呼风声（twirl），从第四十批起每段都有，开头一次、结尾一次。这批把它整个去掉，弩手现身不配声；放箭只留“嘣”那一下 0.12 秒。箭飞出三种：甲 不要飞行声，只有嘣；乙 嘣 + 极短很尖的“咻”（0.12 秒）；丙 嘣 + 一声闷“咔”。象打死在你选的十一层上再叠到十六层，加碎木落地。", "groups": [{"id": "b47_xbow", "who": "拒马", "title": "相只掉血 · 两箭 · 箭声三选一", "hint": "两箭（0.70、0.95），一箭一声。", "clips": [{"id": "b47_xiang_hit_snap", "label": "甲 · 只有放箭“嘣”，没有飞行声（推荐，最干脆）", "text": "甲 · 只嘣", "src": "audio/b47/juma_xiang_hit_snap.mp3"}, {"id": "b47_xiang_hit_zip", "label": "乙 · 嘣 + 极短很尖的“咻”", "text": "乙 · 嘣咻", "src": "audio/b47/juma_xiang_hit_zip.mp3"}, {"id": "b47_xiang_hit_thunk", "label": "丙 · 嘣 + 一声闷“咔”（弩机）", "text": "丙 · 嘣咔", "src": "audio/b47/juma_xiang_hit_thunk.mp3"}]}, {"id": "b47_kill", "who": "拒马", "title": "相击杀、象打死", "hint": "相击杀用甲，木头七层。象打死最后一条是你上一批选的十一层，对照。", "clips": [{"id": "b47_xiang_kill", "label": "相击杀：两箭（甲）+ 虎扑 + 木头七层，没有呼呼声", "text": "相 · 击杀", "src": "audio/b47/juma_xiang_kill.mp3"}, {"id": "b47_ele_kill", "label": "象打死：木头十六层 + 碎木落地", "text": "象 · 打死 · 十六层", "src": "audio/b47/juma_ele_kill.mp3"}, {"id": "b47_ele_kill_ref", "label": "对照：上一批你选的十一层", "text": "象 · 打死 · 十一层（已选）", "src": "audio/b47/ref_ele_kill.mp3"}]}]}, {"id": "b46", "title": "第四十三批 · 拒马：两箭一箭一声、木头断裂更多", "date": "10 月 10 日", "note": "照你的备注：①“放箭声音来个一两声就好了，具体放箭声音需要匹配动画，确保每支箭的动画和声音能匹配上”——改成两箭（0.70、0.95 秒），一箭一声真弓放箭；已经跟角色部说把动画也改成两箭，进游戏时由 TD 在每支箭射出那一帧放声音，所以一定对得上。②“再多点木头断裂声”——相击杀、象打死各出一版木头更多的，和你已经选定的放在一起比。", "groups": [{"id": "b46_xbow", "who": "拒马", "title": "相只掉血 · 两箭", "hint": "一箭一声，第一箭插盾，第二箭入肉。", "clips": [{"id": "b46_xiang_hit_2", "label": "两箭，一箭一声", "text": "相 · 只掉血（两箭）", "src": "audio/b46/juma_xiang_hit_2.mp3"}]}, {"id": "b46_wood", "who": "拒马", "title": "木头断裂多少 · 各挑一个", "hint": "相击杀：三层 / 七层木头断裂。象打死：十一层，对照是你上一批选定的七层。", "clips": [{"id": "b46_xiang_kill_2", "label": "相击杀（两箭）· 木头三层，和你选定那版一样多", "text": "相 · 击杀 · 三层", "src": "audio/b46/juma_xiang_kill_2.mp3"}, {"id": "b46_xiang_kill_2w", "label": "相击杀（两箭）· 木头七层", "text": "相 · 击杀 · 七层", "src": "audio/b46/juma_xiang_kill_2w.mp3"}, {"id": "b46_ele_kill_w", "label": "象打死 · 木头十一层，一路碎到 1.5 秒", "text": "象 · 打死 · 十一层", "src": "audio/b46/juma_ele_kill_w.mp3"}, {"id": "b46_ele_kill_ref", "label": "对照：上一批你选定的象打死（七层）", "text": "象 · 打死 · 七层（已选）", "src": "audio/b46/ref_ele_kill.mp3"}]}]}, {"id": "b45", "title": "第四十二批 · 拒马：弩声换射箭声、象打死木头更多", "date": "10 月 10 日", "note": "照你的备注：①“现在听着像回旋镖……你试试射箭的声音呢？”——像回旋镖的是箭飞出去那段“嗖”，整段去掉；换成 0 A.D. 真弓的放箭声，只取放箭那一下，对准三连射的时刻。出了两种（单纯放箭 / 放箭再加一声闷的“咔”，像弩机），第三条是第四十批用过的老弓声，对照。②象打死：用上一批你选「就它」那版的象声，木头断裂从两层加到七层，一路碎到 1.3 秒，再加几声木板、木头落地。象只掉血你已经定了。看动画对照：https://claude.ai/artifact/5NTW7kpgo3VUJsrosKjube", "groups": [{"id": "b45_xbow", "who": "拒马", "title": "相只掉血 · 弩声三选一", "hint": "同一段“相只掉血”，只换弩声。选一个「就它」，相击杀也用它。", "clips": [{"id": "b45_xiang_hit_bow", "label": "甲 · 真弓放箭声（推荐）", "text": "甲 · 放箭", "src": "audio/b45/juma_xiang_hit_bow.mp3"}, {"id": "b45_xiang_hit_bowthunk", "label": "乙 · 放箭 + 一声闷的“咔”（弩机）", "text": "乙 · 放箭加咔", "src": "audio/b45/juma_xiang_hit_bowthunk.mp3"}, {"id": "b45_xiang_hit_oga", "label": "对照：第四十批的老弓声", "text": "对照 · 老弓", "src": "audio/b45/juma_xiang_hit_oga.mp3"}]}, {"id": "b45_juma", "who": "拒马", "title": "相击杀、象打死", "hint": "相击杀用甲的弩声 + 短促虎扑。象打死的木头断裂加到七层。", "clips": [{"id": "b45_xiang_kill", "label": "相击杀（弩用甲）", "text": "相 · 击杀", "src": "audio/b45/juma_xiang_kill.mp3"}, {"id": "b45_ele_kill", "label": "象打死：上一批的象声 + 七层木头断裂", "text": "象 · 打死", "src": "audio/b45/juma_ele_kill.mp3"}]}]}, {"id": "b44", "title": "第四十一批 · 拒马三段：按备注改", "date": "10 月 10 日", "note": "兵卒对打两版你定了。拒马四段照你的备注改：①“弩的声音不对”：原来那条是弓，换成弩的“嘣”一声弦响（0 A.D. 弩炮发射声的开头，调高变小）加箭出去的“嗖”。②“老虎的声音太慢了，不像攻击”：换成短促的扑击咆哮（0 A.D. 狮子攻击声），起跳就吼，落地再吼一声短的。③象只掉血“需要有被打击的声音”：顶上路障那一下加重撞击、盾被撞响、甲片哗啦、兵挨撞痛叫，后面路障吱呀晃两下。④象打死“木头声音听不到”：木头断裂叠了五层、拉长到半秒多，象的声音压低（木头比象响的差距从约 1 分贝加到 3～7 分贝）。看动画对照：https://claude.ai/artifact/5NTW7kpgo3VUJsrosKjube", "groups": [{"id": "b44_juma", "who": "拒马", "title": "拒马三段（改过的四条）", "hint": "象打死的最后一条是上一批的版本，对比木头声。", "clips": [{"id": "b44_juma_xiang_hit", "label": "相只掉血：弩换成“嘣 + 嗖”", "text": "相 · 只掉血", "src": "audio/b44/juma_xiang_hit.mp3"}, {"id": "b44_juma_xiang_kill", "label": "相击杀：弩换了；虎扑起跳就短促咆哮，砸碎路障，落地再吼", "text": "相 · 击杀", "src": "audio/b44/juma_xiang_kill.mp3"}, {"id": "b44_juma_ele_hit", "label": "象只掉血：顶上路障那一下加重撞击 + 兵挨撞", "text": "象 · 只掉血", "src": "audio/b44/juma_ele_hit.mp3"}, {"id": "b44_juma_ele_kill", "label": "象打死：木头断裂提响、拉长", "text": "象 · 打死", "src": "audio/b44/juma_ele_kill.mp3"}, {"id": "b44_juma_ele_kill_old", "label": "对照：上一批的象打死（木头听不到那版）", "text": "对照 · 上一批", "src": "audio/b44/ref_ele_kill.mp3"}]}]}, {"id": "b43", "title": "第四十批 · 兵卒对打、拒马三段：整段配音", "date": "10 月 10 日", "note": "角色部（原美术）在 M27 给了每个动作在第几秒，我照着把整段声音排出来了，时间和样片的“实际秒”对齐。听法：一边打开样片放动画，一边点这里的声音同时放，看对不对得上。对打样片：https://claude.ai/artifact/9XEAdPkfaXvZUzraWJVr8c ；拒马分镜：https://claude.ai/artifact/5NTW7kpgo3VUJsrosKjube 。用的都是已入库、已署名的素材（盾挡声、气声、欢呼是你刚定的），不花钱。接进游戏后时间可能小调，角色部会再给一次时间点。每段评「就它」/「不行」，哪一下不对就在备注写“几秒那一下太响 / 没听到 / 换成……”。", "groups": [{"id": "b43_duel", "who": "兵卒", "title": "兵卒对打（两版）", "hint": "扣血版：冲刺四步 → 盾挡 1.18 → 反刺破风 → 矛杆相碰 → 扎中肩头（入肉 + 痛叫）2.00 → 踉跄三步 → 顿矛两下 → 挑衅吼一声 → 举盾甲片响 → 再吼。击杀版：冲刺 → 盾挡 1.17 → 扑空破风 → 侧闪衣甲 → 横扫大破风 → 拦腰斩断（劈开 + 血 + 惨叫）2.04 → 下半身跪倒、上半身落地 → 两次跳起吼 → 一群人得胜齐吼。", "clips": [{"id": "b43_duel_hit", "label": "扣血版（约 5.8 秒，对应样片“扣血版”）", "text": "对打 · 扣血", "src": "audio/b43/duel_hit.mp3"}, {"id": "b43_duel_kill", "label": "击杀版（约 5.9 秒，对应样片“击杀版”）", "text": "对打 · 击杀", "src": "audio/b43/duel_kill.mp3"}]}, {"id": "b43_juma", "who": "拒马", "title": "拒马三段（四条）", "hint": "相·只掉血：弩手现身（一阵烟）→ 上弦 → 三连射 0.70 / 0.88 / 1.06 → 中箭：插盾、插木桩、入肉 + 痛叫 → 弩手退下。相·击杀：同上，再虎吼起跳 1.40 → 砸碎路障 1.70（木头断裂、兵惨叫）→ 落地咆哮 2.2。象·只掉血：象吼、奔踏 → 0.80 顶在路障上（木头一挫、吱呀晃两下，不碎）+ 兵挨撞 → 人立长嘶 1.0。象·打死：象吼、奔踏 → 0.80 撞碎路障（比虎扑更响更长）+ 兵被撞飞惨叫 → 1.6 落地 → 踏过去长嘶 1.8。", "clips": [{"id": "b43_juma_xiang_hit", "label": "一、二级相打拒马，只掉血（约 2.4 秒）", "text": "相 · 只掉血", "src": "audio/b43/juma_xiang_hit.mp3"}, {"id": "b43_juma_xiang_kill", "label": "相击杀拒马兵（约 3 秒）", "text": "相 · 击杀", "src": "audio/b43/juma_xiang_kill.mp3"}, {"id": "b43_juma_ele_hit", "label": "楚象打拒马，只掉血（约 2.5 秒）", "text": "象 · 只掉血", "src": "audio/b43/juma_ele_hit.mp3"}, {"id": "b43_juma_ele_kill", "label": "楚象打拒马，打死（约 2.5 秒）", "text": "象 · 打死", "src": "audio/b43/juma_ele_kill.mp3"}]}]}, {"id": "b42", "title": "第三十九批 · 士兵得胜齐吼", "date": "10 月 10 日", "note": "按你说的「要士兵欢呼，不要大笑」：改成吼的语气，不再用高兴的语气（上次听着像笑）。六个男声（含汉兵、楚兵原来的嗓子）喊“吼！吼！吼！”的号子和拖长的“嗬——！”“呜啦——！”“嗷——！”，叠成一群人，配上兵器敲盾（用的是定下的盾挡声）。花了 174 字的额度。可以多选「就它」，选中的随机放。", "groups": [{"id": "b42_vic", "who": "兵卒", "title": "得胜齐吼 · 打倒对方后举着兵器一起吼", "hint": "号子那两条：每个人的三声对齐到同一个拍子上，一声一敲盾；“干”的那条不敲盾，对比用。另外三条是拖长的一声，开头一阵乱敲。", "clips": [{"id": "b42_vic_chant", "label": "号子：十个人“吼！吼！吼！”，每声兵器敲一下盾（推荐）", "text": "吼！吼！吼！", "src": "audio/b42/vic_chant.mp3"}, {"id": "b42_vic_chant_dry", "label": "号子：同上，不敲盾", "text": "吼！吼！吼！（不敲盾）", "src": "audio/b42/vic_chant_dry.mp3"}, {"id": "b42_vic_he", "label": "十个人拖长一声“嗬——！”", "text": "嗬——！", "src": "audio/b42/vic_he.mp3"}, {"id": "b42_vic_wl", "label": "十个人拖长一声“呜啦——！”", "text": "呜啦——！", "src": "audio/b42/vic_wl.mp3"}, {"id": "b42_vic_mix", "label": "十四个人乱吼：嗬、呜啦、嗷混在一起", "text": "齐吼 · 混", "src": "audio/b42/vic_mix.mp3"}]}]}, {"id": "b41", "title": "第三十八批 · 兵卒欢呼", "date": "10 月 10 日", "note": "上一批的群吼你说像嘲讽、不像欢呼。我这边只能上 GitHub，没找到真的欢呼录音，所以用 MiniMax 让六个男声（含汉兵、楚兵原来的嗓子）喊不带词的“嗷——！”“哦吼——！”“喔——！”“哈哈哈哈！”，再错开叠成一群人，加一点空间。花了 174 字的额度。可以多选「就它」，选中的随机放。", "groups": [{"id": "b41_cheer", "who": "兵卒", "title": "欢呼 · 打倒对方后一群人高兴地喊", "hint": "从少到多。笑声那条单独成一种。最后一条是上一批定成嘲讽的群吼，对照用。", "clips": [{"id": "b41_cheer_s", "label": "六个人：嗷、哦吼、喔", "text": "欢呼 · 少", "src": "audio/b41/cheer_s.mp3"}, {"id": "b41_cheer_m", "label": "十个人：嗷、哦吼、喔，夹几声笑", "text": "欢呼 · 中", "src": "audio/b41/cheer_m.mp3"}, {"id": "b41_cheer_l", "label": "十六个人：最热闹", "text": "欢呼 · 多", "src": "audio/b41/cheer_l.mp3"}, {"id": "b41_cheer_laugh", "label": "八个人一起哈哈大笑", "text": "哄笑", "src": "audio/b41/cheer_laugh.mp3"}, {"id": "b41_cheer_ref", "label": "对照：上一批的群吼（已定作嘲讽）", "text": "对照 · 嘲讽", "src": "audio/b41/ref_taunt.mp3"}]}]}, {"id": "b40", "title": "第三十七批 · 兵卒吆喝、欢呼（无台词，真录音）", "date": "10 月 10 日", "note": "按你说的「嘲讽和欢呼都不需要台词，只需要欢呼声吆喝声就行了！找素材就行」：找到 MegaGlest 游戏里真人录的打斗吆喝（CC BY-SA 3.0，和 0 A.D. 一样要署名，上线时请 TD 在「玩法说明」末尾加一行），还有 Warfork 的用力短喝（CC0）。真录音里没找到现成的欢呼，所以欢呼是把七八个人的吆喝错开叠成一群人一起吼。注意：我听不见，没法保证吆喝里完全没有英文词，听到有词的请标「不行」。", "groups": [{"id": "b40_yell", "who": "兵卒", "title": "吆喝 · 出手时一个人吼一声（也当嘲讽用）", "hint": "每条连放几声，是游戏里随机挑的几种。都降了一点调，更像披甲的壮汉。可以多选「就它」，选中的放进同一组随机放。", "clips": [{"id": "b40_yell_guard", "label": "卫兵的吆喝（MegaGlest，5 声）", "text": "卫兵吆喝", "src": "audio/b40/yell_guard.mp3"}, {"id": "b40_yell_sword", "label": "剑兵的吆喝（MegaGlest，4 声）", "text": "剑兵吆喝", "src": "audio/b40/yell_sword.mp3"}, {"id": "b40_yell_mix", "label": "骑兵、棍兵的吆喝（MegaGlest，6 声）", "text": "骑兵棍兵吆喝", "src": "audio/b40/yell_mix.mp3"}, {"id": "b40_yell_wf", "label": "用力短喝，像“嘿！”“哈！”（Warfork，4 声）", "text": "短喝", "src": "audio/b40/yell_wf.mp3"}]}, {"id": "b40_cheer", "who": "兵卒", "title": "欢呼 · 打倒对方后一群人一起吼", "hint": "人越多越响越长。最后一条是游戏里现在的人群呐喊，对照用。", "clips": [{"id": "b40_cheer_0", "label": "六个人", "text": "欢呼 · 少", "src": "audio/b40/cheer_0.mp3"}, {"id": "b40_cheer_1", "label": "九个人", "text": "欢呼 · 中", "src": "audio/b40/cheer_1.mp3"}, {"id": "b40_cheer_2", "label": "十四个人", "text": "欢呼 · 多", "src": "audio/b40/cheer_2.mp3"}, {"id": "b40_cheer_ref", "label": "对照：游戏里现在的人群呐喊", "text": "现有呐喊", "src": "audio/b40/ref_warcry.mp3"}]}]}, {"id": "b39", "title": "第三十六批 · 汉胜、汉败结算曲（代码编的新方案）", "date": "10 月 10 日", "note": "你第二十八批说：汉胜「方案三（礼乐）保留，再写俩」，汉败「原曲保留，再写俩」。MiniMax 的音乐接口对新用户关了（试过三个站点都一样），所以先用代码编，照你挑中的路子：编钟、古筝、古琴、真鼓真锣，结尾拉长慢慢收，不在末尾补一下硬的。响度和原来对齐（胜约 -16，败约 -21）。可以多选「就它」，选中的随机放。", "groups": [{"id": "b39_r_win", "who": "汉·胜", "title": "汉胜 · 两首新的 + 已选的「礼乐」", "hint": "联机里汉方赢了放。「礼乐」是你已经选定的，放在最后对照。新的两首给「就它」就和礼乐一起随机放。", "clips": [{"id": "b39_r_win_3", "label": "「未央」：两声建鼓一声锣开场，编钟和笛子齐奏明亮的宫调，古筝往上拨，最后一声长钟慢慢收（约 17 秒）", "text": "未央", "src": "audio/b39/r_win_3.mp3"}, {"id": "b39_r_win_4", "label": "「大风歌」：古琴低起，编钟一字一顿、琵琶轮指托着，大鼓越来越重，三下重鼓一声锣落在最后一音，钟声余音拉长（约 18 秒）", "text": "大风歌", "src": "audio/b39/r_win_4.mp3"}, {"id": "b39_r_win_2", "label": "对照：已选定的「礼乐」", "text": "礼乐（已选）", "src": "audio/b39/r_win_2.mp3"}]}, {"id": "b39_r_lose", "who": "汉·败", "title": "汉败 · 两首新的 + 原曲", "hint": "联机里汉方输了放。原曲是你说保留的，放在最后对照。新的给「就它」就和原曲一起随机放。", "clips": [{"id": "b39_r_lose_3", "label": "「荥阳」：风声里一支洞箫低低吹一段往下走的旋律，古琴隔一会儿拨一声，远处闷鼓像心跳，一声轻锣（约 18 秒）", "text": "荥阳", "src": "audio/b39/r_lose_3.mp3"}, {"id": "b39_r_lose_4", "label": "「败走」：琵琶轮指拉一段颤抖的下行旋律，二胡低低跟着，鼓点越来越稀，最后一声低钟在风里散掉（约 16 秒）", "text": "败走", "src": "audio/b39/r_lose_4.mp3"}, {"id": "b39_r_lose_old", "label": "对照：原曲（二胡、古琴，你说保留的）", "text": "原曲（保留）", "src": "audio/b39/old_lose.mp3"}]}]}, {"id": "b38", "title": "第三十五批 · 兵卒对打：嘲讽、吼杀、欢呼", "date": "10 月 10 日", "note": "按你的备注「士兵披甲的嘲讽的厮杀庆祝的声音也需要找找」：真实录音的合集里只有外语和英文的人声，用不上，所以用 MiniMax 合成了中文，汉兵、楚兵用原来的嗓子，参数照上次你通过的那批。这批 16 句，花了 209 字的额度。每组第一条是整套示范（带上一批定下的盾挡声）。", "groups": [{"id": "b38_sol_r", "who": "汉兵", "title": "兵卒对打的人声 · 嘲讽、吼杀、欢呼", "hint": "汉兵原来的嗓子（升级、技能句那位）。兵卒对打时：对上之前嘲讽一句，出矛时吼一声，打倒对方后欢呼。每句单独评：「就它」的进游戏随机放，「不行」的写一下哪里不对（太平、太年轻、读音……）。台词也可以改，写在备注里。", "clips": [{"id": "b38_sol_r_seq", "label": "整套示范：嘲讽 → 吼杀 + 两下盾挡 → 欢呼（只是示范，游戏里各在各的时机响）", "text": "整套示范", "src": "audio/b38/sol_r_seq.mp3"}, {"id": "b38_sol_r_t1", "label": "嘲讽", "text": "楚狗，过来送死！", "src": "audio/b38/sol_r_t1.mp3"}, {"id": "b38_sol_r_t2", "label": "嘲讽", "text": "就这点力气？再来啊！", "src": "audio/b38/sol_r_t2.mp3"}, {"id": "b38_sol_r_t3", "label": "嘲讽", "text": "这盾，你破不了！", "src": "audio/b38/sol_r_t3.mp3"}, {"id": "b38_sol_r_f1", "label": "吼杀", "text": "杀——！！", "src": "audio/b38/sol_r_f1.mp3"}, {"id": "b38_sol_r_f2", "label": "吼杀", "text": "给我刺！！", "src": "audio/b38/sol_r_f2.mp3"}, {"id": "b38_sol_r_f3", "label": "吼杀", "text": "顶住！谁也别退！！", "src": "audio/b38/sol_r_f3.mp3"}, {"id": "b38_sol_r_c1", "label": "欢呼", "text": "倒了！哈哈哈！", "src": "audio/b38/sol_r_c1.mp3"}, {"id": "b38_sol_r_c2", "label": "欢呼", "text": "汉军威武！！", "src": "audio/b38/sol_r_c2.mp3"}]}, {"id": "b38_sol_b", "who": "楚兵", "title": "兵卒对打的人声 · 嘲讽、吼杀、欢呼", "hint": "楚兵原来的嗓子（升级、技能句那位）。兵卒对打时：对上之前嘲讽一句，出矛时吼一声，打倒对方后欢呼。每句单独评：「就它」的进游戏随机放，「不行」的写一下哪里不对（太平、太年轻、读音……）。台词也可以改，写在备注里。", "clips": [{"id": "b38_sol_b_seq", "label": "整套示范：嘲讽 → 吼杀 + 两下盾挡 → 欢呼（只是示范，游戏里各在各的时机响）", "text": "整套示范", "src": "audio/b38/sol_b_seq.mp3"}, {"id": "b38_sol_b_t1", "label": "嘲讽", "text": "汉家小儿，也敢挡我？", "src": "audio/b38/sol_b_t1.mp3"}, {"id": "b38_sol_b_t2", "label": "嘲讽", "text": "软绵绵的，没吃饭吗！", "src": "audio/b38/sol_b_t2.mp3"}, {"id": "b38_sol_b_t3", "label": "嘲讽", "text": "躲在盾后面算什么本事！", "src": "audio/b38/sol_b_t3.mp3"}, {"id": "b38_sol_b_f1", "label": "吼杀", "text": "杀——！！", "src": "audio/b38/sol_b_f1.mp3"}, {"id": "b38_sol_b_f2", "label": "吼杀", "text": "破他的盾！！", "src": "audio/b38/sol_b_f2.mp3"}, {"id": "b38_sol_b_f3", "label": "吼杀", "text": "霸王在上，冲！！", "src": "audio/b38/sol_b_f3.mp3"}, {"id": "b38_sol_b_c1", "label": "欢呼", "text": "哈哈哈，又倒一个！", "src": "audio/b38/sol_b_c1.mp3"}, {"id": "b38_sol_b_c2", "label": "欢呼", "text": "大楚威武！！", "src": "audio/b38/sol_b_c2.mp3"}]}]}, {"id": "b37", "title": "第三十四批 · 盾挡声：金属感加重", "date": "10 月 10 日", "note": "按你的备注「再来一些金属感强一点的」：以上一批「还行」的庚、辛为底，铜盾的“锵”分轻、中、重三档，再加两版带甲片哗啦声的（盾后面的人披着甲，挨一下甲片被震响）。素材：0 A.D. 真盾牌录音 + CC0 的铁击、铁皮声，不用加新署名。士兵披甲的嘲讽、吼杀、欢呼人声要用 MiniMax 合成中文，下一批单独出。", "groups": [{"id": "b37_block", "who": "兵卒", "title": "盾挡声 · 金属感从轻到重，五选一", "hint": "从上到下金属感越来越重。庚是上一批的对照（锵最轻）；壬中；癸重；子是壬加甲片哗啦；丑是带出矛“嗖”的整套重版。", "clips": [{"id": "b37_block_g", "label": "对照：上一批的庚（锵很轻）", "text": "庚 · 轻", "src": "audio/b37/block_g.mp3"}, {"id": "b37_block_i", "label": "壬 · 中：铜盾的锵加重，响一下就收", "text": "壬 · 中", "src": "audio/b37/block_i.mp3"}, {"id": "b37_block_j", "label": "癸 · 重：铜盾锵 + 一记铁击，金属为主，木头垫底", "text": "癸 · 重", "src": "audio/b37/block_j.mp3"}, {"id": "b37_block_k", "label": "子 · 披甲：壬 + 挨一下后甲片哗啦一声（推荐）", "text": "子 · 披甲", "src": "audio/b37/block_k.mp3"}, {"id": "b37_block_l", "label": "丑 · 整套重版：出矛“嗖”→ 癸 + 甲片哗啦", "text": "丑 · 整套重", "src": "audio/b37/block_l.mp3"}]}]}, {"id": "b36", "title": "第三十三批 · 盾挡声：真实盾牌录音", "date": "10 月 10 日", "note": "按你上一批的备注「再找一些真实声音素材」：找到 0 A.D. 里真录的木盾、铜盾挨打声（CC BY-SA 3.0，和马蹄同一出处，游戏里已经署过名，不用加新署名）。四个新版本都以真木盾录音为底，最后一条是上一批你选的甲，放着对比。每条连放三下，是游戏里随机放的三个版本。挑一个「就它」；觉得甲还是更好，就给甲点「就它」。", "groups": [{"id": "b36_block", "who": "兵卒", "title": "盾挡声 · 真录音版，五选一", "hint": "兵卒对打时矛扎在盾上被挡住那一下。戊最原汁原味；己更厚更闷；庚在己上加一点铜钉的锵；辛把出矛的“嗖”也带上（整套动作，最长）。", "clips": [{"id": "b36_block_e", "label": "戊 · 原声木盾：真录音，不加工，偏脆、偏轻", "text": "戊 · 原声", "src": "audio/b36/block_e.mp3"}, {"id": "b36_block_f", "label": "己 · 厚盾：真录音降一点调 + 底下一声闷咚", "text": "己 · 厚闷", "src": "audio/b36/block_f.mp3"}, {"id": "b36_block_g", "label": "庚 · 厚盾 + 铜钉：己再加一点真铜盾的“锵”（推荐，最贴美术的描述）", "text": "庚 · 厚闷带锵（推荐）", "src": "audio/b36/block_g.mp3"}, {"id": "b36_block_h", "label": "辛 · 出矛“嗖”→ 挡住：庚前面加出矛的破风声", "text": "辛 · 整套动作", "src": "audio/b36/block_h.mp3"}, {"id": "b36_block_a", "label": "对照：上一批你选的甲（素材叠出来的）", "text": "对照 · 甲", "src": "audio/b36/block_a.mp3"}]}]}, {"id": "b35", "title": "第三十二批 · 兵卒对打的盾挡声", "date": "10 月 10 日", "note": "声音部第一批。美术在做兵卒对打（M26），要一声“矛扎在蒙皮木盾上、被铜钉顶住”：底下一声闷的“咚”，上面一点短促的金属“锵”，比现在的闷击脆、比现在的金属声闷、不拖尾。做了四种配法，都是 CC0 真实录音叠的，不花钱。每条连放三下，是游戏里随机挑的三个变体。请挑一个「就它」；觉得哪个方向对但不够，写在备注里。哪一帧响等美术交动画再对。", "groups": [{"id": "b35_block", "who": "兵卒", "title": "盾挡声 · 四选一", "hint": "兵卒对打时矛扎在盾上被挡住那一下。四条从闷到亮：乙最闷、丁次之、甲居中、丙最亮。最后一条是现在游戏里的闷击和金属声，对照用。", "clips": [{"id": "b35_block_b", "label": "乙 · 皮鼓感：蒙皮的“噗咚”最重，锵很轻", "text": "乙 · 最闷", "src": "audio/b35/block_b.mp3"}, {"id": "b35_block_d", "label": "丁 · 沉木：重木头一声，锵藏在底下", "text": "丁 · 沉", "src": "audio/b35/block_d.mp3"}, {"id": "b35_block_a", "label": "甲 · 木盾 + 铜钉：咚和锵各一半（推荐，最贴美术的描述）", "text": "甲 · 居中（推荐）", "src": "audio/b35/block_a.mp3"}, {"id": "b35_block_c", "label": "丙 · 木板 + 铁片：锵最明显，最短最脆", "text": "丙 · 最亮", "src": "audio/b35/block_c.mp3"}, {"id": "b35_block_ref", "label": "对照：现在游戏里的闷击（前）和金属声（后）", "text": "对照 · 现有声音", "src": "audio/b35/block_ref.mp3"}]}]}]}
