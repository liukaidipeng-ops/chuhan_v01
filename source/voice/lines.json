  "id": "u_r_e_k2",
  "spk": "unit",
  "text": "放箭！"
 },
 {
  "id": "u_r_a_m1",
  "spk": "unit",
  "text": "护住汉王。"
 },
 {
  "id": "u_r_a_m2",
  "spk": "unit",
  "text": "近卫随行。"
 },
 {
  "id": "u_r_a_k1",
  "spk": "unit",
  "text": "犯我汉王者，死！"
 },
 {
  "id": "u_r_a_k2",
  "spk": "unit",
  "text": "樊哙在此！"
 },
 {
  "id": "u_r_k_m1",
  "spk": "unit",
  "text": "随我来。"
 },
 {
  "id": "u_r_k_m2",
  "spk": "unit",
  "text": "稳扎稳打。"
 },
 {
  "id": "u_r_k_m3",
  "spk": "unit",
  "text": "老子换个地方坐坐。"
 },
 {
  "id": "u_r_k_m4",
  "spk": "unit",
  "text": "传令，移驾！"
 },
 {
  "id": "u_r_k_m5",
  "spk": "unit",
  "text": "此地不宜久留。"
 },
 {
  "id": "u_r_k_k1",
  "spk": "unit",
  "text": "拿下！"
 },
 {
  "id": "u_r_k_k2",
  "spk": "unit",
  "text": "天命在汉！"
 },
 {
  "id": "u_r_k_k3",
  "spk": "unit",
  "text": "斩白蛇的剑，还没钝！"
 },
 {
  "id": "u_r_k_k4",
  "spk": "unit",
  "text": "老子亲自动手！"
 },
 {
  "id": "u_b_p_m1",
  "spk": "unit",
  "text": "勇往直前！"
 },
 {
  "id": "u_b_p_m2",
  "spk": "unit",
  "text": "江东子弟，随我来。"
 },
 {
  "id": "u_b_p_k1",
  "spk": "unit",
  "text": "为了江东！"
 },
 {
  "id": "u_b_p_k2",
  "spk": "unit",
  "text": "楚军必胜！"
 },
 {
  "id": "u_b_r_m1",
  "spk": "unit",
  "text": "车马就位。"
 },
 {
  "id": "u_b_r_m2",
  "spk": "unit",
  "text": "驾——向前推进。"
 },
 {
  "id": "u_b_r_k1",
  "spk": "unit",
  "text": "撞开敌阵！"
 },
 {
  "id": "u_b_r_k2",
  "spk": "unit",
  "text": "碾碎他们！"
 },
 {
  "id": "u_b_n_m1",
  "spk": "unit",
  "text": "马不停蹄。"
 },
 {
  "id": "u_b_n_m2",
  "spk": "unit",
  "text": "快马加鞭！"
 },
 {
  "id": "u_b_n_k1",
  "spk": "unit",
  "text": "踏平汉营！"
 },
 {
  "id": "u_b_n_k2",
  "spk": "unit",
  "text": "楚骑天下无敌！"
 },
 {
  "id": "u_b_c_m1",
  "spk": "unit",
  "text": "火炮就位。"
 },
 {
  "id": "u_b_c_m2",
  "spk": "unit",
  "text": "炮车慢点推。"
 },
 {
  "id": "u_b_c_k1",
  "spk": "unit",
  "text": "给我轰！"
 },
 {
  "id": "u_b_c_k2",
  "spk": "unit",
  "text": "炸开他们的阵！"
 },
 {
  "id": "u_b_e_m1",
  "spk": "unit",
  "text": "象阵前行。"
 },
 {
  "id": "u_b_e_m2",
  "spk": "unit",
  "text": "稳住，别惊了大象。"
 },
 {
  "id": "u_b_e_k1",
  "spk": "unit",
  "text": "踏碎他们！"
 },
 {
  "id": "u_b_e_k2",
  "spk": "unit",
  "text": "象阵冲锋！"
 },
 {
  "id": "u_b_a_m1",
  "spk": "unit",
  "text": "誓死护卫霸王。"
 },
 {
  "id": "u_b_a_m2",
  "spk": "unit",
  "text": "守住大营。"
 },
 {
  "id": "u_b_a_k1",
  "spk": "unit",
  "text": "霸王面前，休得放肆！"
 },
 {
  "id": "u_b_a_k2",
  "spk": "unit",
  "text": "护驾！斩！"
 },
 {
  "id": "u_b_k_m1",
  "spk": "unit",
  "text": "哼，不过如此。"
 },
 {
  "id": "u_b_k_m2",
  "spk": "unit",
  "text": "江东子弟，随我前行。"
 },
 {
  "id": "u_b_k_m3",
  "spk": "unit",
  "text": "霸王在此，谁敢近前！"
 },
 {
  "id": "u_b_k_m4",
  "spk": "unit",
  "text": "吾自有分寸。"
 },
 {
  "id": "u_b_k_k1",
  "spk": "unit",
  "text": "力拔山兮！"
 },
 {
  "id": "u_b_k_k2",
  "spk": "unit",
  "text": "挡我者，死！"
 },
 {
  "id": "u_b_k_k3",
  "spk": "unit",
  "text": "吾一人，可敌万人！"
 },
 {
  "id": "u_b_k_k4",
  "spk": "unit",
  "text": "霸王亲至，尔等授首！"
 },
 {
  "id": "b_h_e1",
  "spk": "xiang",
  "text": "项佗！项氏子弟，又折一人！",
  "tts": "项驼！项氏子弟，又折一人。"
 },
 {
  "id": "b_h_r0",
  "spk": "xiang",
  "text": "龙且！吾之猛将，竟折于此！",
  "tts": "龙居！吾之猛将，竟折于此。"
 },
 {
  "id": "r_h_a0",
  "spk": "liu",
  "text": "樊哙！鸿门宴上，你救过寡人的命啊！",
  "tts": "樊快！鸿门宴上，你救过寡人的命啊！"
 },
 {
  "id": "r_h_a1",
  "spk": "liu",
  "text": "纪信！你又替寡人死了一回……"
 },
 {
  "id": "r_h_e0",
  "spk": "liu",
  "text": "子房！没了你，谁替寡人运筹帷幄！"
 },
 {
  "id": "r_h_e1",
  "spk": "liu",
  "text": "萧何！你走了，谁替寡人守这关中啊！"
 },
 {
  "id": "r_h_p0",
  "spk": "liu",
  "text": "周勃！安刘氏者，本该是你啊！"
 },
 {
  "id": "r_h_p2",
  "spk": "liu",
  "text": "王陵！你这直肠子，怎么就走了！"
 },
 {
  "id": "r_h_p3",
  "spk": "liu",
  "text": "卢绾！你我自幼相伴，怎忍先寡人而去！",
  "tts": "卢晚！你我自幼相伴，怎忍先寡人而去！"
 },
 {
  "id": "r_h_r1",
  "spk": "liu",
  "text": "夏侯婴！往后，谁为寡人驾车啊……"
 },
 {
  "id": "r_jq_start",
  "spk": "liu",
  "text": "十五子尽数扣下，翻开方知是何兵马！"
 },
 {
  "id": "r_x_flee",
  "spk": "liu",
  "text": "三十六计，走为上！"
 },
 {
  "id": "r_x_poke",
  "spk": "liu",
  "text": "放肆！寡人的头，也是你碰得的？"
 },
 {
  "id": "r_x_poke2",
  "spk": "liu",
  "text": "再戳，拖出去砍了！"
 }
]