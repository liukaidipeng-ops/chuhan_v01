[
 {
  "id": "w1",
  "spk": "narr",
  "text": "汉五年，项王军壁垓下，兵少食尽，汉军及诸侯兵围之数重。",
  "tts": "汉五年，项王军壁垓下。兵少食尽，汉军及诸侯兵，围之数崇。"
 },
 {
  "id": "w2",
  "spk": "narr",
  "text": "夜闻汉军四面皆楚歌。",
  "tts": "夜，闻汉军，四面皆楚歌。"
 },
 {
  "id": "w3",
  "spk": "xiang",
  "text": "汉皆已得楚乎？是何楚人之多也！"
 },
 {
  "id": "w4",
  "spk": "xiang",
  "text": "力拔山兮气盖世，时不利兮骓不逝。骓不逝兮可奈何，虞兮虞兮奈若何！",
  "tts": "力拔山兮，气盖世。时不利兮，骓不逝。骓不逝兮，可奈何。虞兮，虞兮，奈若何。",
  "speed": 0.72
 },
 {
  "id": "w5",
  "spk": "narr",
  "text": "于是项王乃欲东渡乌江。乌江亭长檥船待。"
 },
 {
  "id": "w6",
  "spk": "elder",
  "text": "江东虽小，地方千里，众数十万人，亦足王也。",
  "tts": "江东虽小，地方千里，众数十万人，亦足旺也。"
 },
 {
  "id": "w7",
  "spk": "elder",
  "text": "愿大王急渡。今独臣有船，汉军至，无以渡。"
 },
 {
  "id": "w8",
  "spk": "xiang",
  "text": "天之亡我，我何渡为！",
  "tts": "天之亡我，我何渡围！",
  "speed": 0.78
 },
 {
  "id": "w9",
  "spk": "xiang",
  "text": "且籍与江东子弟八千人渡江而西，今无一人还。",
  "tts": "且籍与江东子弟八千人，渡江而西，今无一人环。"
 },
 {
  "id": "w10",
  "spk": "xiang",
  "text": "纵江东父兄怜而王我，我何面目见之？",
  "tts": "纵江东父兄，怜而旺我，我何面目见之？"
 },
 {
  "id": "w11",
  "spk": "xiang",
  "text": "纵彼不言，籍独不愧于心乎？"
 },
 {
  "id": "w12",
  "spk": "xiang",
  "text": "吾知公长者。吾骑此马五岁，所当无敌，尝一日行千里，不忍杀之，以赐公。",
  "tts": "吾知公长者。吾骑此马五岁，所当无敌，尝一日行千里。不忍杀之，以赐公。"
 },
 {
  "id": "w13",
  "spk": "narr",
  "text": "乃令骑皆下马步行，持短兵接战。独籍所杀汉军数百人。"
 },
 {
  "id": "w14",
  "spk": "xiang",
  "text": "吾闻汉购我头千金，邑万户，吾为若德。",
  "speed": 0.8
 },
 {
  "id": "w15",
  "spk": "narr",
  "text": "乃自刎而死。",
  "speed": 0.8
 },
 {
  "id": "p1",
  "spk": "narr",
  "text": "汉二年春，汉王部五诸侯兵，凡五十六万人，东伐楚，入彭城。"
 },
 {
  "id": "p2",
  "spk": "narr",
  "text": "收其货宝美人，日置酒高会。"
 },
 {
  "id": "p3",
  "spk": "narr",
  "text": "项王闻之，乃引精兵三万人，晨击汉军而东，至彭城。"
 },
 {
  "id": "p4",
  "spk": "narr",
  "text": "日中，大破汉军。"
 },
 {
  "id": "p5",
  "spk": "narr",
  "text": "汉卒十余万人皆入睢水，睢水为之不流。"
 },
 {
  "id": "p6",
  "spk": "liu",
  "text": "吾宁斗智，不能斗力！",
  "tts": "吾泞斗智，不能斗力！"
 },
 {
  "id": "p7",
  "spk": "narr",
  "text": "楚又追击至灵璧东睢水上，围汉王三匝。"
 },
 {
  "id": "p8",
  "spk": "narr",
  "text": "于是大风从西北而起，折木发屋，扬沙石，窈冥昼晦，逢迎楚军。"
 },
 {
  "id": "p9",
  "spk": "narr",
  "text": "楚军大乱，坏散，而汉王乃得与数十骑遁去。"
 },
 {
  "id": "r_start",
  "spk": "liu",
  "text": "汉王刘邦在此！项籍，可敢一战？"
 },
 {
  "id": "b_start",
  "spk": "xiang",
  "text": "吾乃西楚霸王！谁敢挡我！"
 },
 {
  "id": "r_check",
