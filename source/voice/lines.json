  "text": "此局，天命在汉！"
 },
 {
  "id": "ai_l_lose",
  "spk": "liu",
  "text": "罢了罢了，来日再战！"
 },
 {
  "id": "ai_l_checked",
  "spk": "liu",
  "text": "来得好！"
 },
 {
  "id": "ai_l_reply",
  "spk": "liu",
  "text": "匹夫之勇，何足挂齿！"
 },
 {
  "id": "u_r_p_m1",
  "spk": "unit",
  "text": "稳住阵型，向前！"
 },
 {
  "id": "u_r_p_m2",
