 },
 {
  "id": "ai_l_slow1",
  "spk": "liu",
  "text": "足下沉吟良久，可是无计可施？"
 },
 {
  "id": "ai_l_slow2",
  "spk": "liu",
  "text": "莫要拖延，速速落子！"
 },
 {
  "id": "ai_l_slow3",
