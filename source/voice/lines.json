 {
  "id": "ai_x_cap1",
  "spk": "xiang",
  "text": "不堪一击！"
 },
 {
  "id": "ai_x_cap2",
  "spk": "xiang",
  "text": "此等兵马，也敢挡我？"
 },
 {
  "id": "ai_x_cap3",
  "spk": "xiang",
  "text": "哈哈哈哈！再来！"
 },
 {
  "id": "ai_x_cap4",
  "spk": "xiang",
  "text": "螳臂当车，自取灭亡！"
 },
 {
  "id": "ai_x_slow1",
  "spk": "xiang",
  "text": "竖子，何故迟疑？"
 },
 {
  "id": "ai_x_slow2",
  "spk": "xiang",
  "text": "再不落子，莫非是怕了？"
 },
 {
  "id": "ai_x_slow3",
  "spk": "xiang",
  "text": "磨磨蹭蹭，天都要亮了！"
 },
 {
  "id": "ai_x_hurt",
  "spk": "xiang",
  "text": "可恶！此仇必报！"
 },
 {
  "id": "ai_x_undo",
