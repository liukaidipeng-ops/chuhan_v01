  "text": "天下，终归西楚！"
 },
 {
  "id": "ai_x_lose",
  "spk": "xiang",
  "text": "此天之亡我，非战之罪也！"
 },
 {
  "id": "ai_x_checked",
  "spk": "xiang",
  "text": "雕虫小技！"
 },
 {
  "id": "ai_x_reply",
  "spk": "xiang",
  "text": "口舌之争，何足道哉！"
 },
 {
  "id": "ai_l_cap1",
  "spk": "liu",
  "text": "承让了。"
 },
 {
  "id": "ai_l_cap2",
  "spk": "liu",
  "text": "此子，我便收下了。"
 },
 {
  "id": "ai_l_cap3",
  "spk": "liu",
  "text": "足下，大势已去矣。"
 },
 {
  "id": "ai_l_cap4",
  "spk": "liu",
