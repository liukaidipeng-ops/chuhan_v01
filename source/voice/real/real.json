{
 "text": {
  "u_b_c_m2": "炮车快点推！",
  "u_b_c_k2": "炸飞他们！",
  "u_b_e_m2": "稳住！别惊了大象！",
  "bf_art_b2": "背水一战！破釜沉舟！",
  "bf_art_b": "破釜沉舟！",
  "t_u_r_e_m1": "白虎开道。",
  "t_u_r_e_m2": "谋定而后动。",
  "t_u_r_e_k1": "犯汉者，虎噬之！",
  "t_u_r_e_k2": "放虎！",
  "up_r_p_2_1": "当上伍长了，五个弟兄跟我走！",
  "up_r_p_2_2": "伍长在此，都给我站齐了！",
  "up_r_p_3_1": "什长了！十个弟兄，一个都不能少。",
  "up_r_p_3_2": "什长领队——跟紧我！",
  "up_r_r_2_1": "换了轻车，跑得更快了！",
  "up_r_r_2_2": "轻车已备，随时出击！",
  "up_r_r_3_1": "武刚车结阵，坚如城墙！",
  "up_r_r_3_2": "武刚车到，看谁冲得动！",
  "up_r_n_2_1": "骁骑上马，随时冲杀！",
  "up_r_n_2_2": "马快刀利，骁骑来也！",
  "up_r_n_3_1": "郎中骑，随灌将军破敌！",
  "up_r_n_3_2": "郎中骑到，楚骑休狂！",
  "up_r_c_2_1": "抛石机架好了，砸他个措手不及！",
  "up_r_c_2_2": "石弹装满，听令就放！",
  "up_r_c_3_1": "霹雳车上阵，一声惊雷！",
  "up_r_c_3_2": "霹雳车在，什么城墙都砸得开！",
  "up_r_e_2_1": "白虎听令，长史上任。",
  "up_r_e_2_2": "驭虎长史，奉命而行。",
  "up_r_e_3_1": "持汉节，护三军。",
  "up_r_e_3_2": "节在人在，护军在此！",
  "up_r_a_2_1": "郎卫上值，汉王身边有我。",
  "up_r_a_2_2": "升了郎卫，寸步不离汉王！",
  "up_r_a_3_1": "中涓近侍，替汉王挡刀！",
  "up_r_a_3_2": "中涓在侧，汉王放心。",
  "up_b_p_2_1": "锐卒！江东子弟不输人！",
  "up_b_p_2_2": "楚锐卒，听令向前！",
  "up_b_p_3_1": "持戟在手，谁敢近前！",
  "up_b_p_3_2": "戟锋所指，敌阵自开！",
  "up_b_r_2_1": "戎车已驾，楚军出击！",
  "up_b_r_2_2": "戎车开道，都跟上！",
  "up_b_r_3_1": "陷阵车，专破坚阵！",
  "up_b_r_3_2": "陷阵车到，汉阵必破！",
  "up_b_n_2_1": "楚骁骑，来去如风！",
  "up_b_n_2_2": "骁骑上马——追！",
  "up_b_n_3_1": "乌骓骑，与霸王同驰！",
  "up_b_n_3_2": "跟着乌骓跑，谁追得上！",
  "up_b_c_2_1": "抛石就位，砸烂汉营！",
  "up_b_c_2_2": "石弹上好了，等他们来！",
  "up_b_c_3_1": "霹雳炮响，天崩地裂！",
  "up_b_c_3_2": "霹雳炮上阵，叫汉军尝尝！",
  "up_b_e_2_1": "战象披挂，踏平汉阵！",
  "up_b_e_2_2": "大象发怒了，都退后！",
  "up_b_e_3_1": "云梦泽的巨象，出山了！",
  "up_b_e_3_2": "巨象一步，地动山摇！",
  "up_b_a_2_1": "楚郎卫，护卫霸王左右！",
  "up_b_a_2_2": "郎卫上值，大营无忧。",
  "up_b_a_3_1": "执戟郎，守在帐前！",
  "up_b_a_3_2": "当年韩信也做过执戟郎——我可不跑！",
  "h_r_r0_up1": "臣多多而益善耳！",
  "h_r_r0_up2": "萧丞相说信国士无双——今日便见分晓！",
  "h_r_r1_up1": "太仆夏侯婴，为大王执辔！",
  "h_r_r1_up2": "彭城那么险都冲出来了，坐稳！",
  "h_r_p0_up1": "织箔吹箫的周勃，今天也当将军了！",
  "h_r_p0_up2": "勃重厚少文，只管往前打！",
  "h_r_p1_up1": "身被七十创，曹参照样上阵！",
  "h_r_p1_up2": "攻城略地，曹参功最多！",
  "h_r_p2_up1": "老母伏剑，陵誓死事汉王！",
  "h_r_p2_up2": "汉王长者，王陵绝无二心！",
  "h_r_p3_up1": "与大王同日生，绾愿同日战！",
  "h_r_p3_up2": "丰邑同乡的卢绾，又来帮大王了！",
  "h_r_p4_up1": "横阳起兵，傅宽一路随大王至今！",
  "h_r_p4_up2": "魏五大夫骑将傅宽，听令！",
  "h_r_a1_up1": "事已急矣，臣请为王诳楚！",
  "h_r_a1_up2": "黄屋左纛，纪信替大王坐一回！",
  "h_r_e0_up1": "臣请借前箸，为大王筹之。",
  "h_r_e0_up2": "博浪沙一椎误中副车——这回不会了。",
  "h_r_e1_up1": "诸将争金帛，何独收图书。",
  "h_r_e1_up2": "关中有何，粮草不绝！",
  "h_b_r0_up1": "吾平生知韩信为人，易与耳！",
  "h_b_r0_up2": "龙且奉霸王之命，渡水破汉！",
  "h_b_r1_up1": "项王骨鲠之臣，钟离昧在此！",
  "h_b_r1_up2": "陈平反间？昧的心是铁打的！",
  "h_b_p0_up1": "得黄金百斤，不如得季布一诺！",
  "h_b_p0_up2": "季布数窘汉王，今日再窘一回！",
  "h_b_p1_up1": "人相我当刑而王，几是乎！",
  "h_b_p1_up2": "黥面英布，为楚军前锋！",
  "h_b_p2_up1": "江东虞子期，誓随霸王！",
  "h_b_p2_up2": "为霸王，也为我妹子，子期死战！",
  "h_b_p3_up1": "亡在泽中的桓楚，回来了！",
  "h_b_p3_up2": "只有项籍知道我在哪——我来也！",
  "h_b_p4_up1": "楚大司马周殷，领九江之兵！",
  "h_b_p4_up2": "骨鲠之臣周殷，绝不负楚！",
  "h_b_a0_up1": "军中无以为乐，请以剑舞！",
  "h_b_a0_up2": "项庄舞剑，意在沛公！",
  "h_b_a1_up1": "楚左尹项伯，项王季父是也！",
  "h_b_a1_up2": "子房是故交……今日各为其主！",
  "h_b_e0_up1": "居鄛范增，年七十，好奇计！",
  "h_b_e0_up2": "玉玦举了三回——这回莫再放走沛公！",
  "h_b_e1_up1": "项氏宗亲项佗，愿为霸王效死！",
  "h_b_e1_up2": "当年领兵救魏，今日为霸王破汉！",
  "h_r_r0_m1": "明修栈道，暗度陈仓。",
  "h_r_r0_m2": "兵贵神速，随我来。",
  "h_r_r0_a1": "击其不备，出其不意！",
  "h_r_r0_a2": "列阵——进击！",
  "h_r_r0_k1": "此战，不过如此。",
  "h_r_r0_s_chongzhen": "陷之死地而后生——冲！",
  "h_r_r1_m2": "车往哪走，婴心里有数。",
  "h_r_r1_a1": "撞过去！",
  "h_r_r1_a2": "鞭子一响——冲！",
  "h_r_r1_k1": "婴这车，挡者必倒！",
  "h_r_r1_s_chongzhen": "太仆驾车，冲阵！",
  "h_r_r1_sk_chongzhen": "冲过去了，大王放心！",
  "h_r_p0_m1": "勃，只管往前！",
  "h_r_p0_m2": "大步走，别磨蹭！",
  "h_r_p0_a1": "看刀！",
  "h_r_p0_a2": "打的就是你！",
  "h_r_p0_k1": "又拿下一个！",
  "h_r_p0_s_juma": "拒马立住，来吧！",
  "h_r_p1_m1": "伤疤多了，路照样走！",
  "h_r_p1_m2": "随我攻城略地！",
  "h_r_p1_a1": "杀！",
  "h_r_p1_a2": "再添一道伤又如何！",
  "h_r_p1_k1": "又是一功！",
  "h_r_p1_s_juma": "拒马立住，寸步不让！",
  "h_r_p2_m1": "王陵做事，直来直去！",
  "h_r_p2_m2": "走就走，绕什么弯！",
  "h_r_p2_a1": "有种别跑！",
  "h_r_p2_a2": "替我老母报仇！",
  "h_r_p2_k1": "母亲，儿又斩一人！",
  "h_r_p2_s_juma": "拒马架上，看谁敢来！",
  "h_r_p2_sk_juma": "活该撞上来！",
  "h_r_p3_m1": "大王放心，绾在！",
  "h_r_p3_m2": "老兄弟，跟上！",
  "h_r_p3_a1": "敢欺负大王？打！",
  "h_r_p3_a2": "丰邑的拳头，尝尝！",
  "h_r_p3_k1": "回去给大王报喜！",
  "h_r_p3_s_juma": "拒马架好，替大王挡着！",
  "h_r_p3_sk_juma": "挡住了！",
  "h_r_p4_m1": "傅宽在前，诸军随我！",
  "h_r_p4_m2": "随大王一路至今，一步不退！",
  "h_r_p4_a1": "骑将傅宽来也！",
  "h_r_p4_a2": "冲上去，杀！",
  "h_r_p4_k1": "斩了！下一个！",
  "h_r_p4_s_juma": "拒马架起，阵脚不动！",
  "h_r_p4_sk_juma": "撞得好！",
  "h_r_a1_m1": "臣在王侧。",
  "h_r_a1_m2": "纪信随行。",
  "h_r_a1_a1": "为汉王，死不足惜！",
  "h_r_a1_a2": "拼了！",
  "h_r_a1_k1": "此身尚在，再战！",
  "h_r_a1_s_hujia": "臣替大王留下，大王快走！",
  "h_r_e0_m1": "运筹之中，不必着急。",
  "h_r_e0_m2": "良，自有安排。",
  "h_r_e0_a1": "时机已到。",
  "h_r_e0_a2": "此一击，早有定计。",
  "h_r_e0_k1": "果然不出所料。",
  "h_r_e0_s_feiyue": "白虎，越过去。",
  "h_r_e0_sk_feiyue": "一跃而定。",
  "h_r_e0_s_qishe": "放箭，不必留情。",
  "h_r_e0_sk_qishe": "一箭而决。",
  "h_r_e1_m1": "粮草已备，可以走了。",
  "h_r_e1_m2": "镇守后方的萧何，也能上阵！",
  "h_r_e1_a1": "律令在此，犯者当诛！",
  "h_r_e1_a2": "萧何也会打仗！",
  "h_r_e1_k1": "依律，当斩。",
  "h_r_e1_s_feiyue": "追韩信那晚的脚力还在！",
  "h_r_e1_sk_feiyue": "追上了！",
  "h_r_e1_s_qishe": "诸弩齐发！",
  "h_r_e1_sk_qishe": "一律射杀！",
  "h_b_r0_m1": "韩信小儿，何足挂齿。",
  "h_b_r0_m2": "龙且所向，无人能挡！",
  "h_b_r0_a1": "冲过去，碾碎他们！",
  "h_b_r0_a2": "胯下之夫，也配一战？",
  "h_b_r0_k1": "易与耳！",
  "h_b_r0_s_chongzhen": "渡水冲阵！",
  "h_b_r0_sk_chongzhen": "汉军，不过如此！",
  "h_b_r1_m1": "昧，随项王进退。",
  "h_b_r1_m2": "楚军听令，向前！",
  "h_b_r1_a1": "为项王，杀！",
  "h_b_r1_a2": "汉贼，受死！",
  "h_b_r1_k1": "昧不负项王！",
  "h_b_r1_s_chongzhen": "钟离昧，冲阵！",
  "h_b_p0_m1": "一诺既出，必至。",
  "h_b_p0_m2": "季布说到做到。",
  "h_b_p0_a1": "今日再窘汉王！",
  "h_b_p0_a2": "看枪！",
  "h_b_p0_k1": "说斩你，就斩你。",
  "h_b_p0_s_juma": "季布说守，就守得住！",
  "h_b_p0_sk_juma": "一诺千金，一个不放！",
  "h_b_p1_m1": "黥布当先！",
  "h_b_p1_m2": "跟着我，杀个痛快！",
  "h_b_p1_a1": "给我死！",
  "h_b_p1_a2": "黥面的来了，怕不怕！",
  "h_b_p1_k1": "哈！痛快！",
  "h_b_p1_s_juma": "拒马架上，谁敢冲！",
  "h_b_p1_sk_juma": "撞死一个！",
  "h_b_p2_m1": "子期随霸王出征！",
  "h_b_p2_m2": "江东子弟，跟上！",
  "h_b_p2_a1": "为霸王而战！",
  "h_b_p2_a2": "看我长枪！",
  "h_b_p2_k1": "妹子，哥又立一功！",
  "h_b_p2_s_juma": "拒马架好，守住大营！",
  "h_b_p2_sk_juma": "休想过去！",
  "h_b_p3_m1": "泽里走惯了，这点路算什么！",
  "h_b_p3_m2": "嘿，往这边！",
  "h_b_p3_a1": "野路子，专打你！",
  "h_b_p3_a2": "从泽里杀出来了！",
  "h_b_p3_k1": "嘿嘿，又一个！",
  "h_b_p3_s_juma": "削木为拒，泽中老法子！",
  "h_b_p3_sk_juma": "掉进陷阱了吧！",
  "h_b_p4_m1": "大司马率军前进。",
  "h_b_p4_m2": "九江之兵，随我来。",
  "h_b_p4_a2": "听令——攻！",
  "h_b_p4_k1": "此功，记下了。",
  "h_b_p4_sk_juma": "来者，皆败。",
  "h_b_a0_m1": "剑在手，随时可舞。",
  "h_b_a0_m2": "项庄护卫在侧。",
  "h_b_a0_a1": "看剑！",
  "h_b_a0_a2": "剑舞，开始了！",
  "h_b_a0_k1": "这一剑，总算舞完了！",
  "h_b_a0_s_hujia": "霸王请退，庄来挡！",
  "h_b_a1_m1": "左尹随行。",
  "h_b_a1_m2": "罢了，走吧。",
  "h_b_a1_a1": "得罪了！",
  "h_b_a1_a2": "各为其主，莫怪！",
  "h_b_a1_k1": "唉……这又何必。",
  "h_b_a1_s_hujia": "以身翼蔽——霸王请退！",
  "h_b_e0_m1": "老夫走一步，看三步。",
  "h_b_e0_m2": "竖子……罢了，走吧。",
  "h_b_e0_a1": "此子不除，必为后患！",
  "h_b_e0_a2": "老夫早算到了！",
  "h_b_e0_k1": "哼，早该如此。",
  "h_b_e0_s_feiyue": "老夫也跨得过去！",
  "h_b_e0_sk_feiyue": "奇计，奇计！",
  "h_b_e1_m1": "项氏子弟，随我来。",
  "h_b_e1_m2": "象阵，前行。",
  "h_b_e1_a1": "为项氏，冲！",
  "h_b_e1_a2": "踏过去！",
  "h_b_e1_k1": "项氏旗下，又添一功！",
  "h_b_e1_s_feiyue": "巨象，越！",
  "h_b_e1_sk_feiyue": "一脚定乾坤！",
  "sk_r_juma_1": "架起拒马！谁来谁挨刺！",
  "sk_r_juma_2": "长矛立住，等他撞上来！",
  "sk_r_juma_k": "撞上拒马了吧！",
  "sk_r_chongzhen_1": "冲阵！撞开他们！",
  "sk_r_chongzhen_2": "武刚车，冲过去！",
  "sk_r_chongzhen_k": "一冲到底，敌阵已破！",
  "sk_r_taying_1": "踏营！直取中军！",
  "sk_r_taying_2": "绕过去，踏他的营！",
  "sk_r_taying_k": "营已踏破！",
  "sk_r_pili_1": "霹雳车，放！",
  "sk_r_pili_2": "瞄准了——砸！",
  "sk_r_pili_k": "砸了个正着！",
  "sk_r_feiyue_1": "白虎，跃！",
  "sk_r_feiyue_2": "一跃而过！",
  "sk_r_feiyue_k": "虎跃扑杀！",
  "sk_r_hujia_1": "护驾！汉王快走！",
  "sk_r_hujia_2": "臣来换位，汉王退后！",
  "sk_b_juma_1": "长戟架好，来一个刺一个！",
  "sk_b_juma_2": "架起拒马，守住！",
  "sk_b_juma_k": "自己撞上来的！",
  "sk_b_chongzhen_1": "陷阵车，冲！",
  "sk_b_chongzhen_2": "撞开汉阵！",
  "sk_b_chongzhen_k": "冲垮了！",
  "sk_b_taying_1": "乌骓骑，踏营！",
  "sk_b_taying_2": "直插汉营！",
  "sk_b_taying_k": "汉营踏平了！",
  "sk_b_pili_1": "霹雳炮，轰！",
  "sk_b_pili_k": "轰个稀烂！",
  "sk_b_feiyue_1": "巨象越阵！",
  "sk_b_feiyue_2": "大象跨过去！"
 },
 "note": "写实版配音（MiniMax）：每条是试听台上通过的那一条；刘邦统一加了大殿混响；t_ 开头的是汉相换成虎骑之后用的台词（现在只在 ?tiger=1 预览里用）；2026-10-05 加了一批将帅的台词（b20：走子 / 吃子各加两句、王不见王、哀名将、彩蛋），同样是试听台上通过的那一条"
}