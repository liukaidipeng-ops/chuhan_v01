 },
 "real_u_r_p_m1": {
  "note": "汉兵 · 强悍士兵",
  "text": "稳住阵型，向前！"
 },
 "real_u_r_p_m2": {
  "note": "汉兵 · 强悍士兵",
  "text": "跟紧了，别掉队。"
 },
 "real_u_r_p_k1": {
  "note": "汉兵 · 强悍士兵",
  "text": "汉军威武！"
 },
 "real_u_r_p_k2": {
  "note": "汉兵 · 强悍士兵",
  "text": "拿下此阵！"
 },
 "real_u_r_r_m1": {
  "note": "汉兵 · 强悍士兵",
  "text": "战车出阵。"
 },
 "real_u_r_r_m2": {
  "note": "汉兵 · 强悍士兵",
  "text": "驾！稳着点。"
