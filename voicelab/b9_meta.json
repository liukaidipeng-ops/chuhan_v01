  "text": "灌将军有令，出发。"
 },
 "real_u_r_n_k1": {
  "note": "汉兵 · 强悍士兵",
  "text": "斩将夺旗！"
 },
 "real_u_r_n_k2": {
  "note": "汉兵 · 强悍士兵",
  "text": "踏破敌营！"
 },
 "real_u_r_c_m1": {
