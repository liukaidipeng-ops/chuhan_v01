{
 "real_ai_x_cap1": {
  "note": "加一声冷笑，不指定情绪",
  "text": "(chuckle)不堪一击！"
 },
 "real_ai_x_cap4": {
  "note": "更怒：力度拉满、加音量",
  "text": "螳臂当车，自取灭亡！"
 },
 "real_ai_x_slow2": {
  "note": "轻蔑，句尾接冷笑",
  "text": "再不落子，莫非是怕了？(chuckle)"
 },
 "real_b_check_a": {
  "note": "甲 · 两字拆开，重音压在“军”",
  "text": "将、军！"
 },
 "real_b_check_b": {
  "note": "乙 · 不拆字，放慢",
  "text": "将军！！"
 },
 "real_b_mate_a": {
  "note": "甲 · 两字拆开，放慢",
  "text": "绝、杀！"
 },
 "real_b_mate_b": {
  "note": "乙 · 不拆字，更慢",
  "text": "绝杀！！"
 },
 "real_bf_art_b": {
  "note": "更怒、放慢、喊出来",
  "text": "破釜沉舟！<#0.15#>有进无退！"
 },
 "real_bf_art_b2": {
  "note": "更怒、放慢、喊出来",
  "text": "背水一战！<#0.15#>有进无退！"
 },
 "real_u_b_k_k1": {
  "note": "放慢、力度拉满",
  "text": "力拔山兮！"
 },
 "real_u_b_k_k2": {
  "note": "放慢、力度拉满",
  "text": "挡我者，死！"
 },
 "real_w3": {
  "note": "改成恐惧",
  "text": "汉皆已得楚乎？是何楚人之多也！"
 },
 "real_w4": {
  "note": "加快",
  "text": "力拔山兮，气盖世。时不利兮，骓不逝。骓不逝兮，可奈何。虞兮，虞兮，奈若何。"
 },
 "real_w9": {
  "note": "更悲：力度放软、再慢一点",
  "text": "且籍与江东子弟八千人渡江而西，今无一人还。"
 },
 "real_w10": {
  "note": "更悲怆",
  "text": "纵江东父兄怜而王我，我何面目见之？"
 },
 "real_w12": {
  "note": "带感情：悲",
  "text": "吾知公长者。吾骑此马五岁，所当无敌，尝一日行千里，不忍杀之，以赐公。"
 },
 "real_ai_l_win": {
  "note": "激昂、霸气",
  "text": "此局，天命在汉！"
 },
 "real_p6": {
  "note": "不那么平：轻蔑带笑",
  "text": "(chuckle)吾宁斗智，<#0.15#>不能斗力！"
 },
 "real_r_bad6_a": {
  "note": "甲 · “庶子”后顿一下",
  "text": "愚蠢！庶子，不可教也！"
 },
 "real_r_bad6_b": {
  "note": "乙 · 一口气说完，不加停顿",
  "text": "(snorts)愚蠢！庶子不可教也！"
 },
 "real_r_check_a": {
  "note": "甲 · 两字拆开，重音压在“军”",
  "text": "将、军！"
 },
 "real_r_check_b": {
  "note": "乙 · 不拆字，放慢",
  "text": "将军！！"
 },
 "real_r_mate": {
  "note": "更霸气",
  "text": "绝杀！"
 },
 "real_r_t0": {
  "note": "更喜悦，带笑",
  "text": "(laughs)好棋！"
 },
 "real_r_t3": {
  "note": "更轻蔑",
  "text": "(chuckle)尔等，已是瓮中之鳖。"
 },
 "real_r_t5": {
  "note": "更激动",
  "text": "此局，天命在我！"
 },
 "real_r_t7": {
  "note": "更激动",
  "text": "再来一局，决一雌雄！"
 },
 "real_u_r_k_k1": {
  "note": "激昂",
  "text": "拿下！"
 },
 "real_u_r_k_k2": {
  "note": "激昂、霸气",
  "text": "天命在汉！"
 },
 "real_u_r_k_m1": {
  "note": "激昂",
  "text": "随我来！"
 },
 "real_w1": {
  "note": "沉着：放慢、压低",
  "text": "汉五年，项王军壁垓下，兵少食尽，汉军及诸侯兵围之数重。"
 },
 "real_w2": {
  "note": "沉着：放慢、压低",
  "text": "夜闻汉军四面皆楚歌。"
 },
 "real_w5": {
  "note": "沉着：放慢、压低",
  "text": "于是项王乃欲东渡乌江。乌江亭长檥船待。"
 },
 "real_w13": {
  "note": "沉着：放慢、压低",
  "text": "乃令骑皆下马步行，持短兵接战。独籍所杀汉军数百人。"
 },
 "real_w15": {
  "note": "沉着：放慢、压低",
  "text": "乃自刎而死。"
 },
 "real_p1": {
  "note": "沉着：放慢、压低",
  "text": "汉二年春，汉王部五诸侯兵，凡五十六万人，东伐楚，入彭城。"
 },
 "real_p2": {
  "note": "沉着：放慢、压低",
  "text": "收其货宝美人，日置酒高会。"
 },
 "real_p3": {
  "note": "沉着：放慢、压低",
  "text": "项王闻之，乃引精兵三万人，晨击汉军而东，至彭城。"
 },
 "real_p4": {
  "note": "沉着：放慢、压低",
  "text": "日中，大破汉军。"
 },
 "real_p5": {
  "note": "沉着：放慢、压低",
  "text": "汉卒十余万人皆入睢水，睢水为之不流。"
 },
 "real_p7": {
  "note": "沉着：放慢、压低",
  "text": "楚又追击至灵璧东睢水上，围汉王三匝。"
 },
 "real_p8": {
  "note": "沉着：放慢、压低",
  "text": "于是大风从西北而起，折木发屋，扬沙石，窈冥昼晦，逢迎楚军。"
 },
 "real_p9": {
  "note": "沉着：放慢、压低",
  "text": "楚军大乱，坏散，而汉王乃得与数十骑遁去。"
 },
 "real_w6": {
  "note": "平静，不激动",
  "text": "江东虽小，地方千里，众数十万人，亦足王也。"
 },
 "real_w7": {
  "note": "平静，不激动",
  "text": "愿大王急渡。今独臣有船，汉军至，无以渡。"
 },
